# SMTP Credentials for Zoho Mail (Care Coordination Portal)
# Replace these values in your local .env file. DO NOT commit actual credentials!

# The sender/receiver email address for Zoho SMTP
ZOHO_EMAIL_USER=your-email@auromil.com

# Zoho Mail App Password (specifically generated for SMTP/applications, not account password)
ZOHO_EMAIL_PASS=your-zoho-app-password
